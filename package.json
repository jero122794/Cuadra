{
  "name": "cuadra",
  "version": "1.0.0",
  "description": "Cuadra: rompecabezas de bloques para web, Android e iOS",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "levels": "node --experimental-strip-types scripts/generate-levels.ts",
    "cap:sync": "npm run build && npx cap sync",
    "android": "npm run cap:sync && npx cap open android",
    "ios": "npm run cap:sync && npx cap open ios",
    "build:play": "npm run build && node -e \"require('fs').mkdirSync('docs',{recursive:true});require('fs').copyFileSync('dist/index.html','docs/index.html')\""
  },
  "devDependencies": {
    "@capacitor/cli": "7.4.2",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vite-plugin-singlefile": "2.0.3",
    "vitest": "2.1.4"
  },
  "dependencies": {
    "@capacitor-community/admob": "7.0.3",
    "@capacitor/android": "7.4.2",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "7.4.2",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/ios": "7.4.2",
    "@fontsource/bungee": "5.1.0",
    "@fontsource/rubik": "5.1.0"
  }
}
